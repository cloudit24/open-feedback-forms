# Local secrets and machine-specific config — never commit these.
config.json
*.env
.env.bak.*
.env.recovered

# Installer safety backups (settings, uploads, database dumps)
backup/

# Build artifacts (regenerated by packaging/build-msi.ps1)
build/
dist/
packaging/out/
*.spec

# Uploaded logos and any local data directory
uploads/
data/

# Python
__pycache__/
*.pyc

# Logs
*.log
install.log
