# Copy to .env and fill in — install.sh does this for you interactively.
# .env itself is gitignored; never commit real credentials here.

# --- ports (usually fine as-is) ---
ADMIN_PORT=8080
FORM_PORT=8081

# --- optional hardening ---
TURNSTILE_SECRET=
RATE_LIMIT=5

# --- bundled MariaDB (only used if COMPOSE_PROFILES=bundled-db below) ---
# COMPOSE_PROFILES=bundled-db
# DB_NAME=open_feedback_forms
# DB_USER=off_app
# DB_PASSWORD=
# DB_ROOT_PASSWORD=
# OFF_WAIT_FOR_DB_HOST=db
# OFF_WAIT_FOR_DB_PORT=3306
